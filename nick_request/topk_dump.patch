+#!/usr/bin/env bash
+# Top-K candidate dump on a theta list, using fit_theta_all_best_one_theta.py.
+# Same directory conventions as plot_eps_vs_theta.py LoadMatrix() (norm "V" = 2/3^f).
+# Output: fits_topk_f=${f}.txt  (fits_f=N.txt format + trailing ", frob , rank").
+#
+#   thetas.txt : one theta per line (e.g. the first column of your fits_f=${f}.txt:
+#                grep -v '^#' fits_f=8.txt | cut -d, -f1 > thetas_f=8.txt )
+
+f="8"
+lab="1e-4"          # eps label of the D/V_f=${f}/eps=${lab} directory
+eps="1e-4"          # --eps for the candidate disks
+K=100
+tol=1.25
+thetas="thetas_f=${f}.txt"
+
+mpi="mpirun -n 16"
+dir="D/V_f=${f}/eps=${lab}"
+out="fits_topk_f=${f}.txt"
+rm -f "${out}"
+
+while read -r th; do
+  [[ -z "${th}" || "${th}" == \#* ]] && continue
+  $mpi python3 -m zeta9.fit_theta_all_best_one_theta \
+    --triples_file "${dir}/triples" \
+    --triples_json "${dir}/triples.manifest.json" \
+    --rootdb_prefix "${dir}/roots_local" \
+    --y2_good_npz "${dir}/roots_y2_good_m1.npz" \
+    --f "${f}" \
+    --norm "2/3^f" \
+    --eps "${eps}" \
+    --theta "${th}" \
+    --output_prefix "${dir}/topk_tmp" \
+    --topk ${K} --tol ${tol} \
+    --topk_txt "${out}" --topk_append \
+    --quiet
+done < "${thetas}"
+echo "wrote ${out}"
