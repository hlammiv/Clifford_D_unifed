+def DumpTopK(k=100, tol=1.25, lab="1e-4", f=8, norm="V", mod="", nout=0, out=None):
+    """Top-K variant of Dump().
+
+    Dump() writes, for each special theta, the one matrix that generated it.
+    DumpTopK() additionally ranks EVERY matrix stored in
+    out.phase_free_special_theta.npz (all groups x all root pairs) by its raw
+    Frobenius distance to R_z(theta) = diag(e^{-i theta/2}, e^{i theta/2}, 1),
+    and writes, per theta, all matrices with frob <= tol * best (at most k),
+    sorted by frob.  Same text format as fits_f=N.txt plus two trailing columns
+    ", frob , rank".  The pool can be enlarged by re-running
+    find_phase_free_special_theta_exactdiff with a larger --top_n.
+    """
+    fname = f"D/{norm}_f={f}{mod}/eps={lab}/out.phase_free_special_theta.npz"
+    d = np.load(fname)
+    idxoff = d['theta_off']
+    theta = d['theta']
+    gc3 = d['group_coeff3']
+    coeff = np.empty((len(theta),3,6),dtype=np.int64)
+    for i in range(len(idxoff)-1):
+        i0 = idxoff[i]; i1 = idxoff[i+1]
+        coeff[i0:i1,0] = d['coeff1'][i0:i1]
+        coeff[i0:i1,1] = d['coeff2'][i0:i1]
+        coeff[i0:i1,2] = gc3[i]
+
+    # unique matrices in the pool (exact coefficient key)
+    _, uidx = np.unique(coeff.reshape(len(coeff),-1), axis=0, return_index=True)
+    pool = coeff[np.sort(uidx)]
+    X01 = np.array([[0,1,0],[1,0,0],[0,0,1]], dtype=np.complex128)
+    I = np.eye(3, dtype=np.complex128)
+    V = np.empty((len(pool),3,3), dtype=np.complex128)
+    for n in range(len(pool)):
+        x = vector_coeffs_to_complex(pool[n], f)
+        V[n] = X01 @ (I - 3**f*np.outer(np.conj(x), x))
+
+    # target thetas: the same (sorted, de-duplicated) list Dump() writes
+    th = np.sort(theta)
+    th = th[np.append([True], np.diff(th) > 1e-14)]
+    if(nout > 0):
+        th = th[::(len(th)+nout-1)//nout]
+
+    if(out is None): out = f"fits_topk_f={f}.txt"
+    nrow = 0
+    with open(out,"wt") as fh:
+        fh.write(f"#f={f}\n")
+        fh.write("# columns: theta, 3^f*Mij (3x3 6-element-groups), frob, rank\n")
+        for t in th:
+            T = np.diag([np.exp(-0.5j*t), np.exp(0.5j*t), 1.0+0.0j])
+            frob = np.linalg.norm(V - T, axis=(1,2))
+            order = np.argsort(frob, kind="mergesort")
+            cut = tol*frob[order[0]]
+            seen = set()
+            r = 0
+            for n in order:
+                if(frob[n] > cut or r >= k): break
+                M = householder_int_matrix(pool[n], f, "2/3^f")[1]   # == MatrixC6(pool[n], f), no Sage text parsing
+                key = str(M)
+                if(key in seen): continue
+                seen.add(key)
+                fh.write(f"{t}")
+                for j in range(3):
+                    for i in range(3):
+                        fh.write(" ,")
+                        for m in range(6):
+                            fh.write(f" {M[i][j][m]}")
+                fh.write(f" , {frob[n]:.17g} , {r}\n")
+                r += 1
+                nrow += 1
+    print(f"f={f}: pool={len(pool)} thetas={len(th)} rows={nrow} -> {out}")
+#
