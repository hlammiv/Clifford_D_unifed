+# ============================================================
+# Optional top-K dump (--topk K --tol T).  Default --topk 0 = old behaviour.
+# ============================================================
+
+
+_householder_denominator_exponent = householder_denominator_exponent
+_householder_int_matrix = householder_int_matrix
+
+
+def _householder_matrix_frob(coeffs: np.ndarray, f: int, lam: float, theta: float) -> float:
+    """Raw Frobenius distance ||V - diag(e^{-i th/2}, e^{i th/2}, 1)||_F."""
+    u = np.asarray([coeffs_to_complex_noscale(r) for r in coeffs], dtype=np.complex128) / float(3 ** int(f))
+    V = (np.eye(3, dtype=np.complex128) - float(lam) * np.outer(np.conjugate(u), u))[[1, 0, 2], :]
+    T = np.diag([np.exp(-0.5j * float(theta)), np.exp(0.5j * float(theta)), 1.0 + 0.0j])
+    E = V - T
+    return float(math.sqrt(max(0.0, np.vdot(E, E).real)))
+
+
+class _TopKCollector:
+    """Per-rank bounded pool of the K best candidates by matrix Frobenius error.
+
+    Candidates that produce an identical exact matrix (e.g. x and a unit multiple
+    of x) are kept once.
+    """
+
+    def __init__(self, k: int, *, f: int, lam: float, theta: float, norm_label: str):
+        self._heapq = heapq
+        self.k = int(k)
+        self.f = int(f)
+        self.lam = float(lam)
+        self.theta = float(theta)
+        self.norm_label = str(norm_label)
+        self.heap = []      # (-frob, seq, key, record)
+        self.keys = set()
+        self.seq = 0
+        self.offered = 0
+
+    def offer(self, coeffs3: np.ndarray, Y3: np.ndarray, vec_d2: float, triple_row: int):
+        self.offered += 1
+        frob = _householder_matrix_frob(coeffs3, self.f, self.lam, self.theta)
+        if len(self.heap) >= self.k and frob >= -self.heap[0][0]:
+            return
+        _, N = _householder_int_matrix(coeffs3, self.f, self.norm_label)
+        key = tuple(v for row in N for ent in row for v in ent)
+        if key in self.keys:
+            return
+        rec = {
+            "frob": frob,
+            "vec_dist": math.sqrt(max(0.0, float(vec_d2))),
+            "coeffs": np.asarray(coeffs3, dtype=np.int64).copy(),
+            "Y": np.asarray(Y3, dtype=np.int64).copy(),
+            "triple_row": int(triple_row),
+            "key": key,
+        }
+        self.seq += 1
+        item = (-frob, self.seq, key, rec)
+        self.keys.add(key)
+        if len(self.heap) < self.k:
+            self._heapq.heappush(self.heap, item)
+        else:
+            old = self._heapq.heapreplace(self.heap, item)
+            self.keys.discard(old[2])
+
+    def records(self):
+        return [it[3] for it in self.heap]
+
+
+def _merge_topk_records(parts, k: int, tol: float):
+    """Merge per-rank records: dedup by exact matrix, sort by frob, keep
+    frob <= tol * best_frob, cap at k."""
+    seen = set()
+    recs = []
+    for part in parts:
+        for r in part:
+            if r["key"] in seen:
+                continue
+            seen.add(r["key"])
+            recs.append(r)
+    recs.sort(key=lambda r: (r["frob"], r["triple_row"]))
+    if not recs:
+        return []
+    cut = float(tol) * recs[0]["frob"]
+    recs = [r for r in recs if r["frob"] <= cut]
+    return recs[: int(k)]
+
+
+def _write_topk_txt(path: str, *, f: int, norm_label: str, theta: float, recs, fmt: str = "matrix",
+                    append: bool = False):
+    """Write top-K rows in the fits_f=N.txt text format plus trailing frob, rank.
+
+    matrix: theta , 9 groups of 6 ints (3^e * V_ij, same element order as
+            dump_special_thetas.py, i.e. column-major j-outer/i-inner) , frob , rank
+            with header '#f=e' (e = f for norm 2/3^f, 2f for norm 2).
+    vector: theta , 3 groups of 6 ints (3^f * x_i, Householder vector) , frob , rank
+            with header '#f=f norm=<label> vector'.
+    """
+    write_header = not (append and os.path.exists(path) and os.path.getsize(path) > 0)
+    with open(path, "a" if append else "w") as fh:
+        if write_header:
+            if fmt == "vector":
+                fh.write(f"#f={int(f)} norm={norm_label} vector\n")
+                fh.write("# columns: theta, 3^f*x_i (3 6-element-groups), frob, rank;"
+                         " V = X01 (I - lam conj(x) x^T), lam = 3^f for norm 2/3^f, 1 for norm 2\n")
+            else:
+                e = _householder_denominator_exponent(f, norm_label)
+                fh.write(f"#f={e}\n")
+                fh.write("# columns: theta, 3^f*Mij (3x3 6-element-groups), frob, rank\n")
+        for rank_i, r in enumerate(recs):
+            fh.write(f"{float(theta)}")
+            if fmt == "vector":
+                for i in range(3):
+                    fh.write(" ,")
+                    for m in range(6):
+                        fh.write(f" {int(r['coeffs'][i][m])}")
+            else:
+                _, N = _householder_int_matrix(r["coeffs"], f, norm_label)
+                for j in range(3):
+                    for i in range(3):
+                        fh.write(" ,")
+                        for m in range(6):
+                            fh.write(f" {N[i][j][m]}")
+            fh.write(f" , {r['frob']:.17g} , {rank_i}\n")
+
