+def householder_denominator_exponent(f, norm_label="2/3^f"):
+    """Exponent e such that 3^e * V has entries in Z[zeta_9], for
+    V = X01 (I - lam conj(x) x^T), x = c/3^f:
+      norm 2/3^f: lam = 3^f, 3^f V = 3^f I - conj(c) c^T      (e = f)
+      norm 2    : lam = 1,   3^(2f) V = 3^(2f) I - conj(c) c^T (e = 2f)
+    """
+    return int(f) if str(norm_label).strip() in ("2/3^f", "2/3**f") else 2 * int(f)
+
+
+def householder_int_matrix(coeffs, f, norm_label="2/3^f"):
+    """Exact integer form of the Householder-built matrix (no Sage needed).
+
+    coeffs: (3,6) integer coefficients of c = 3^f x.
+    Returns (e, N) with N a 3x3 nested list of 6-tuples of Python ints such that
+    N[i][j] = 3^e * V[i][j]; V = X01 (I - lam conj(x) x^T) (rows 0,1 swapped).
+    Same matrix as MatrixC6() in dump_special_thetas.py.
+    """
+    e = householder_denominator_exponent(f, norm_label)
+    c = [tuple(int(v) for v in coeffs[i]) for i in range(3)]
+    cc = [conj(ci) for ci in c]
+    big = 3 ** e
+    H = [[None] * 3 for _ in range(3)]
+    for i in range(3):
+        for j in range(3):
+            m = [-v for v in mul(cc[i], c[j])]
+            if i == j:
+                m[0] += big
+            H[i][j] = tuple(m)
+    return e, [H[1], H[0], H[2]]
+
